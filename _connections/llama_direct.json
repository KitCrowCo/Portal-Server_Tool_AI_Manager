{
  "_meta": {"schema_version": "1.0", "connection_type": "llamacpp_direct", "display_name": "llama.cpp (direct, no vendor ceilings)",
            "description": "Ollama-wire-compatible llama.cpp supervisor. No hardcoded iGPU/context-size cutoffs, native KV-cache persistence, native LoRA hot-swap. Distinct from ollama.json because the wire protocol is shared but the actual capability surface is not."},
  "prefix_breaking_fields": ["model", "system_prompt", "num_ctx"],
  "connection": {"host": {"type":"string","default":"127.0.0.1","required":true}, "port": {"type":"integer","default":11434,"required":true},
                 "tls": {"type":"boolean","default":false}, "base_path": {"type":"string","default":""}, "timeout_s": {"type":"integer","default":3600}},
  "capabilities": {"list_models": true, "chat": true, "generate": true, "streaming": true,
                    "context_cache_save": true, "context_cache_load": true, "lora_adapters": true},
  "endpoints": {
    "health":        {"method": "GET",  "path": "/api/tags"},
    "list_models":   {"method": "GET",  "path": "/api/tags"},
    "chat":          {"method": "POST", "path": "/api/chat", "body": {"model": "{model}", "messages": "{messages}", "stream": true, "options": "{options}"}},
    "context_cache_save": {"method": "POST", "path": "/api/cache/save", "body": {"model": "{model}", "cache_id": "{cache_id}"}},
    "context_cache_load": {"method": "POST", "path": "/api/cache/load", "body": {"model": "{model}", "cache_id": "{cache_id}"}},
    "lora_list": {"method": "GET",  "path": "/api/lora/list"},
    "lora_set":  {"method": "POST", "path": "/api/lora/set", "body": {"adapters": "{adapters}"}}
  },
  "options_schema": {"temperature": {"type":"float","default":0.8}, "top_p": {"type":"float","default":0.9}, "num_predict": {"type":"integer","default":-1}},
  "response_parser": {"stream_format": "jsonl", "content_path": "message.content"}
}